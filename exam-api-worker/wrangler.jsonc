{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pl300-managed-exams-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://bassamelshoraa.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pl300-managed-exams",
      "database_id": "11289879-81e1-4335-a847-8f8f14ed8dcc",
      "migrations_dir": "migrations"
    }
  ]
}
