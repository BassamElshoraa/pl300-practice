{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pl300-ai-tutor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://bassamelshoraa.github.io,https://pl300-practice-exam.bassamelshoraa.chatgpt.site",
    "TEXT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "VISION_MODEL": "@cf/qwen/qwen3.8-27b",
  },
  "observability": { "enabled": true },
}
